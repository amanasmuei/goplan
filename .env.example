# =============================================================================
# GoPlan Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before running docker-compose.
#
#   cp .env.example .env
#
# SECURITY: Never commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------

# Database username (default: goplan)
POSTGRES_USER=goplan

# Database password -- REQUIRED, no default. Generate a strong random password.
# Example: openssl rand -base64 32
POSTGRES_PASSWORD=

# SSL mode for database connections.
# Use "disable" for local development, "require" or "verify-full" in production.
DB_SSLMODE=disable

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Secret key used to sign and verify JWT tokens -- REQUIRED, no default.
# Must be a long, random, unpredictable string (minimum 32 characters).
# Example: openssl rand -base64 48
JWT_SECRET=

# JWT token expiration in hours (default: 24)
JWT_EXPIRATION_HOURS=24

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Password for Redis authentication.
# In production, set a strong unique password.
# Example: openssl rand -base64 32
REDIS_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Claude AI Integration
# -----------------------------------------------------------------------------

# API key for Anthropic Claude. Required for AI strategy generation.
# Obtain from: https://console.anthropic.com/
CLAUDE_API_KEY=

# Claude model to use (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Maximum tokens per AI response (default: 8192)
AI_MAX_TOKENS=8192

# Enable/disable AI features (default: true)
AI_ENABLED=true

# AI request timeout in seconds (default: 120)
AI_TIMEOUT_SEC=120

# AI rate limit in requests per minute (default: 30)
AI_RATE_LIMIT_RPM=30

# AI temperature for response creativity (default: 0.7)
AI_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed origins for cross-origin requests.
# In production, restrict this to your actual frontend domain(s).
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe (Subscriptions)
# -----------------------------------------------------------------------------

# Stripe secret key for payment processing.
# Obtain from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for verifying webhook events.
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for subscription tiers.
STRIPE_PRO_PRICE_ID=
STRIPE_PRO_PLUS_PRICE_ID=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------

# Backend API URL for the frontend. Used at build time.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
