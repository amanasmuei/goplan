# ===========================================
# GoPlan Staging Environment Configuration
# Copy this file and fill in values for staging
# ===========================================

# ----- Server -----
PORT=8080
HOST=0.0.0.0
ENV=staging
LOG_LEVEL=debug
LOG_FORMAT=json

# ----- Database -----
# Use a separate staging database (smaller instance than production)
DATABASE_URL=postgres://goplan:STAGING_PASSWORD@staging-db.rds.amazonaws.com:5432/goplan_staging?sslmode=require
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
DATABASE_MAX_IDLE_TIME=5m

# ----- Redis -----
# Use a separate staging Redis (smaller instance than production)
REDIS_URL=rediss://:STAGING_PASSWORD@staging-redis.cache.amazonaws.com:6379
REDIS_DB=0

# ----- Authentication -----
# Use different secrets for staging
JWT_SECRET=STAGING_SECRET_MIN_32_CHARACTERS_LONG
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
BCRYPT_COST=12

# ----- AI (Claude) -----
# Can use same API key with lower rate limits
CLAUDE_API_KEY=sk-ant-your-staging-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096
AI_TIMEOUT=30s
AI_ENABLED=true
AI_RATE_LIMIT_RPM=30

# ----- Email (Staging - SendGrid Sandbox or Mailhog) -----
# Option 1: SendGrid with sandbox mode
SENDGRID_API_KEY=SG.your-staging-sendgrid-api-key
SMTP_FROM=staging@goplan.io

# Option 2: Mailhog for email testing
# SMTP_HOST=mailhog.staging.svc.cluster.local
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=

# ----- OAuth (Optional) -----
# Use staging OAuth apps with staging redirect URIs
OAUTH_GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-staging-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-staging-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-staging-github-client-secret

# ----- Storage -----
# Use separate staging bucket
STORAGE_TYPE=s3
S3_BUCKET=goplan-staging-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-staging-aws-access-key
S3_SECRET_KEY=your-staging-aws-secret-key

# ----- Security -----
# Staging domains
CORS_ORIGINS=https://staging.goplan.io
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ----- Observability -----
OTEL_ENABLED=true
OTEL_ENDPOINT=https://staging-otel-collector:4317
OTEL_SERVICE_NAME=goplan-api-staging
SENTRY_DSN=https://your-staging-sentry-dsn@sentry.io/project-id

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=https://api.staging.goplan.io/api/v1
NEXT_PUBLIC_WS_URL=wss://api.staging.goplan.io/ws
NEXT_PUBLIC_APP_URL=https://staging.goplan.io
NEXT_PUBLIC_APP_NAME=GoPlan (Staging)

# ----- Frontend Analytics -----
# Can disable or use staging analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ===========================================
# Staging-specific settings
# ===========================================
# Enable debug mode
DEBUG=true
# Enable verbose logging
VERBOSE=true
# Seed test data on startup
SEED_DATA=true
