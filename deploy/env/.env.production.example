# ===========================================
# GoPlan Production Environment Configuration
# Copy this file and fill in values for production
# ===========================================

# ----- Server -----
PORT=8080
HOST=0.0.0.0
ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# ----- Database -----
# Use a managed PostgreSQL service (AWS RDS, GCP Cloud SQL, etc.)
DATABASE_URL=postgres://goplan:SECURE_PASSWORD@your-db-host.rds.amazonaws.com:5432/goplan?sslmode=require
DATABASE_MAX_CONNS=50
DATABASE_MIN_CONNS=10
DATABASE_MAX_IDLE_TIME=5m

# ----- Redis -----
# Use a managed Redis service (AWS ElastiCache, Redis Enterprise, etc.)
REDIS_URL=rediss://:SECURE_PASSWORD@your-redis-host.cache.amazonaws.com:6379
REDIS_DB=0

# ----- Authentication -----
# IMPORTANT: Generate a secure random secret (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d
BCRYPT_COST=12

# ----- AI (Claude) -----
CLAUDE_API_KEY=sk-ant-your-production-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514
AI_MAX_TOKENS=4096
AI_TIMEOUT=30s
AI_ENABLED=true
AI_RATE_LIMIT_RPM=60

# ----- Email (Production - SendGrid) -----
SENDGRID_API_KEY=SG.your-production-sendgrid-api-key
SMTP_FROM=noreply@goplan.io

# ----- OAuth (Optional) -----
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# ----- Storage -----
# Use cloud storage in production (S3, GCS, etc.)
STORAGE_TYPE=s3
S3_BUCKET=goplan-production-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your-aws-access-key
S3_SECRET_KEY=your-aws-secret-key
# S3_ENDPOINT= # Only needed for S3-compatible services

# ----- Security -----
# List your production domains
CORS_ORIGINS=https://goplan.io,https://www.goplan.io
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=200
RATE_LIMIT_WINDOW=1m

# ----- Observability -----
OTEL_ENABLED=true
OTEL_ENDPOINT=https://your-otel-collector:4317
OTEL_SERVICE_NAME=goplan-api
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ----- Frontend (Next.js) -----
NEXT_PUBLIC_API_URL=https://api.goplan.io/api/v1
NEXT_PUBLIC_WS_URL=wss://api.goplan.io/ws
NEXT_PUBLIC_APP_URL=https://goplan.io
NEXT_PUBLIC_APP_NAME=GoPlan

# ----- Frontend Analytics -----
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# Kubernetes Secrets (if using external-secrets)
# These reference external secret stores
# ===========================================
# DATABASE_URL: vault:secret/data/goplan/production#database_url
# JWT_SECRET: vault:secret/data/goplan/production#jwt_secret
# CLAUDE_API_KEY: vault:secret/data/goplan/production#claude_api_key
